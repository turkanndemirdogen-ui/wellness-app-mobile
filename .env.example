# Wellness App — mobil istemci ortam değişkenleri
# Bu dosyayı `.env` olarak kopyala ve değerleri Supabase panelinden doldur.
# Kopyala:  cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
#
# ÖNEMLİ: `.env` git'e GİRMEZ (.gitignore'da). Sadece bu örnek dosya paylaşılır.
# EXPO_PUBLIC_ önekli değişkenler istemci paketine gömülür — buraya YALNIZCA
# public (anon) anahtar konur. service_role anahtarı ASLA buraya/istemciye konmaz.

# Supabase proje URL'i (Panel > Project Settings > Data API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon/public anahtarı (Panel > Project Settings > API Keys > anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
